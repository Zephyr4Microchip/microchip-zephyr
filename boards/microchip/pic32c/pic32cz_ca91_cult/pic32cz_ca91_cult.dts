/dts-v1/;
#include <microchip/pic32c/pic32cz_ca/pic32cz_ca91/pic32cz4010ca91208.dtsi>
#include "pic32cz_ca91_cult-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "PIC32CZ CA91 Curiosity Ultra";
	compatible = "microchip,pic32cz_ca91_cult";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &nvmctrl;
		zephyr,console = &sercom1;
		zephyr,shell-uart = &sercom1;
		zephyr,code-partition = &slot0_partition;
		zephyr,entropy = &trng;
		zephyr,sdhc = &sdhc1;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &button0;
		sw1 = &button1;
		eeprom-0 = &eeprom;
		sdhc0 = &sdhc1;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&portb 21 GPIO_ACTIVE_LOW>;
			label = "User LED 0";
		};

		led1: led_1 {
			gpios = <&portb 22 GPIO_ACTIVE_LOW>;
			label = "User LED 1";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&portb 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW0";
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&portc 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW1";
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* 128KB BFM for bootloader */
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(128)>;
		};

		/* 1.75MB for slot0 partition */
		slot0_partition: partition@4000000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x04000000 DT_SIZE_K(1792)>;
		};

		/* 1.75MB for slot1 partition */
		slot1_partition: partition@41c0000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x041c0000 DT_SIZE_K(1792)>;
		};

		/* 512kB for storage partition */
		storage_partition: partition@4380000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x04380000 DT_SIZE_K(512)>;
		};
	};
};

&cpu0 {
	clock-frequency = <240000000>;
};

&clock {
	compatible = "microchip,pic32cz-ca-clock";

	xosc: xosc {
		compatible = "microchip,pic32cz-ca-xosc";
		xosc-frequency = <12000000>;
		xosc-en = <1>;
		xosc-xtal-en = <1>;
		xosc-usb-ref-clock-div = "div1";
	};

	dpll: dpll {
		compatible = "microchip,pic32cz-ca-dpll";

		dpll0: dpll0 {
			subsystem = <CLOCK_MCHP_DPLL_ID_DPLL0>;
			dpll-bandwidth-sel = "10mhz-20mhz";
			dpll-ref-division-factor = <1>;
			dpll-feedback-divider-factor = <100>; /* Fvco = 1200Mhz */
			dpll-src = "xosc";
			dpll-en = <1>;

			dpll0out0: dpll0out0 {
				/* CPU = 1200/5 = 240Mhz */
				subsystem = <CLOCK_MCHP_DPLL0_ID_OUT0>;
				dpll-output-division-factor = <5>;
				dpll-output-en = <1>;
			};

			dpll0out1: dpll0out1 {
				/* SDHC core clk = 1200/12 = 100Mhz */
				subsystem = <CLOCK_MCHP_DPLL0_ID_OUT1>;
				dpll-output-division-factor = <12>;
				dpll-output-en = <1>;
			};

			dpll0out2: dpll0out2 {
				/*
				 * Used for SDHC slow clock.
				 * 1200 / 50 = 24 MHz. Divide by 50 to stay above 12.7MHz floor
				 */
				subsystem = <CLOCK_MCHP_DPLL0_ID_OUT2>;
				dpll-output-division-factor = <50>;
				dpll-output-en = <1>;
			};
		};

		dpll1: dpll1 {
			subsystem = <CLOCK_MCHP_DPLL_ID_DPLL1>;
			dpll-bandwidth-sel = "4mhz-10mhz";
			dpll-ref-division-factor = <3>;
			dpll-feedback-divider-factor = <250>;
			dpll-src = "xosc";
			dpll-en = <1>;

			dpll1out0: dpll1out0 {
				subsystem = <CLOCK_MCHP_DPLL1_ID_OUT0>;
				dpll-output-division-factor = <8>;
				dpll-output-en = <1>;
				dpll-fractional-divider-int = <0>;
				dpll-fractional-divider-rem = <0>;
			};
		};
	};

	xosc32k: xosc32k {
		compatible = "microchip,pic32cz-ca-xosc32k";
		xosc32k-xtal-en = <1>;
		xosc32k-control-gain-mode = "higher-than-cgm7";
		xosc32k-en = <1>;
	};

	gclkgen: gclkgen {
		compatible = "microchip,pic32cz-ca-gclkgen";

		gclkgen0 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN0>;
			gclkgen-div-factor = <1>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "pll0-clkout0";
			gclkgen-en = <1>;
		};

		gclkgen1 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN1>;
			gclkgen-div-factor = <6>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "pll0-clkout0";
			gclkgen-en = <1>;
		};

		gclkgen2 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN2>;
			gclkgen-div-factor = <1>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "pll1-frc-clkout0";
			gclkgen-en = <1>;
		};

		/* GCLK for SDHC core clock - 100 MHz from PLL0_OUT1 */
		gclkgen3 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN3>;
			gclkgen-div-factor = <1>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "pll0-clkout1";
			gclkgen-en = <1>;
		};

		/* GCLK for SDHC slow clock - 24/2 = 12 MHz from PLL0_OUT2 */
		gclkgen4 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN4>;
			gclkgen-div-factor = <2>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "pll0-clkout2";
			gclkgen-en = <1>;
		};
	};

	gclkperiph: gclkperiph {
		compatible = "microchip,pic32cz-ca-gclkperiph";
		#clock-cells = <1>;

		sercom1 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM1_CORE>;
			gclkperiph-src = "gclk0";
			gclkperiph-en = <1>;
		};

		sercom9 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM9_CORE>;
			gclkperiph-src = "gclk1";
			gclkperiph-en = <0>;
		};

		sercom2 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM2_CORE>;
			gclkperiph-src = "gclk0";
			gclkperiph-en = <1>;
		};

		gmac_tx {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_GMAC_TX>;
			gclkperiph-src = "gclk2";
			gclkperiph-en = <1>;
		};

		gmac_tsu {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_GMAC_TSU>;
			gclkperiph-src = "gclk2";
			gclkperiph-en = <1>;
		};

		sdhc1_core {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SDHC1_CORE>;
			gclkperiph-src = "gclk3";
			gclkperiph-en = <1>;
		};

		sdhc1_slow {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SDHC1_SLOW>;
			gclkperiph-src = "gclk4";
			gclkperiph-en = <1>;
		};
	};

	mclkdomain: mclkdomain {
		compatible = "microchip,pic32cz-ca-mclkdomain";

		mclkcpu {
			subsystem = <CLOCK_MCHP_MCLKDOMAIN_ID_CPU>;
			mclk-div = <1>;
		};

		mclkperiph {
			subsystem = <CLOCK_MCHP_MCLKDOMAIN_ID_PERIPH>;
			mclk-div = <2>;
		};
	};

	mclkperiph: mclkperiph {
		compatible = "microchip,pic32cz-ca-mclkperiph";
		#clock-cells = <1>;

		sercom1 {
			subsystem = <CLOCK_MCHP_MCLKPERIPH_ID_SERCOM1>;
			mclk-en = <1>;
		};

		sercom2 {
			subsystem = <CLOCK_MCHP_MCLKPERIPH_ID_SERCOM2>;
			mclk-en = <1>;
		};

		husb0 {
			subsystem = <CLOCK_MCHP_MCLKPERIPH_ID_HUSB0>;
			mclk-en = <1>;
		};

		gmac_ahb {
			subsystem = <CLOCK_MCHP_MCLKPERIPH_ID_GMAC_AHB>;
			mclk-en = <1>;
		};

		gmac_apb {
			subsystem = <CLOCK_MCHP_MCLKPERIPH_ID_GMAC_APB>;
			mclk-en = <1>;
		};

		sdhc1 {
			subsystem = <CLOCK_MCHP_MCLKPERIPH_ID_SDHC1_AHB>;
			mclk-en = <1>;
		};
	};
};

&portb {
	status = "okay";
};

&portc {
	status = "okay";
};

&portg {
	status = "okay";
};

&sercom1 {
	compatible = "microchip,sercom-g1-uart";
	#address-cells = <1>;
	#size-cells = <0>;
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	stop-bits = "1";
	rxpo = <3>;
	txpo = <0>;
	pinctrl-0 = <&sercom1_uart_default>;
	pinctrl-names = "default";
	status = "okay";
};

&dmac {
	status = "okay";
};

i2c0: &sercom9 {
	compatible = "microchip,sercom-g1-i2c";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&sercom9_i2c_default>;
	pinctrl-names = "default";
	dmas = <&dmac 2 0x17>, <&dmac 3 0x18>;
	dma-names = "rx", "tx";
	status = "okay";

	eeprom: eeprom@56 {
		compatible = "atmel,at24", "atmel,24mac402";
		reg = <0x56>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
	};

	eeprom_mac: eeprom@5e {
		compatible = "atmel,at24", "atmel,24mac402";
		reg = <0x5e>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			mac_address: mac-address@9a {
				reg = <0x9a 6>;
				#nvmem-cell-cells = <0>;
			};
		};
	};
};

&gmac {
	compatible = "microchip,gmac-g1-eth";
	pinctrl-0 = <&gmac_gmii>;
	pinctrl-names = "default";

	nvmem-cells = <&mac_address>;
	nvmem-cell-names = "mac-address";
	phy-connection-type = "gmii";
	phy-handle = <&phy>;
	status = "okay";
};

&mdio {
	compatible = "microchip,gmac-g1-mdio";
	pinctrl-0 = <&mdio_default>;
	pinctrl-names = "default";
	status = "okay";

	phy: ethernet-phy@3 {
		compatible = "ethernet-phy";
		status = "okay";
		reg = <3>;
		reset-gpios = <&portb 23 GPIO_ACTIVE_LOW>;
		reset-assert-duration-us = <10000>;
		reset-deassertion-timeout-ms = <1>;
	};
};

zephyr_udc0: &hsusb0 {
	status = "okay";
};

zephyr_udc1: &hsusb1 {
	/* USBHS1 (Type-C connector) is disabled – USBHS0 (hsusb0, Micro A/B
	 * connector) is used as the primary USB device controller via the
	 * zephyr_udc0 alias above.
	 */
	status = "disabled";
};

&sdhc1 {
	compatible = "microchip,sdhc-g1";
	pinctrl-0 = <&sdhc1_default>;
	pinctrl-names = "default";
	auto-cmd23;
	auto-cmd12;
	status = "okay";

	disk {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};
